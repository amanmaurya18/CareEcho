# NextAuth Configuration
# Local Development (runs at http://localhost:3000):
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=your_nextauth_secret_key_here

# Note for Vercel:
# In Vercel Project Settings -> Environment Variables:
# - NEXTAUTH_URL: Set to https://your-production-url.vercel.app (ONLY select "Production")
# - NEXTAUTH_SECRET: Set to your random 32-byte secret (select Production, Preview, Development)

# Google OAuth Credentials (from Google Cloud Console)
GOOGLE_CLIENT_ID=your_google_client_id_here
GOOGLE_CLIENT_SECRET=your_google_client_secret_here

# GitHub OAuth Credentials (from GitHub Developer Settings)
GITHUB_ID=your_github_client_id_here
GITHUB_SECRET=your_github_client_secret_here
